package cns;

import java.math.BigInteger;
import java.util.Random;
import java.util.Scanner;

public class RSA {

    static Scanner sc = new Scanner(System.in);

    public static void main(String[] args) {

        // Ask user to input two prime numbers
        System.out.print("Enter a prime number p: ");
        BigInteger p = sc.nextBigInteger();

        System.out.print("Enter another prime number q: ");
        BigInteger q = sc.nextBigInteger();

        // Compute modulus n = p * q
        BigInteger n = p.multiply(q);

        // Compute φ(n) = (p-1)*(q-1)
        BigInteger phi = (p.subtract(BigInteger.ONE)).multiply(q.subtract(BigInteger.ONE));

        // Generate public exponent e
        BigInteger e = generateE(phi);

        // Compute private exponent d (multiplicative inverse of e mod phi)
        BigInteger d = e.modInverse(phi);

        // Print public and private keys
        System.out.println("\nEncryption (public) keys: " + e + ", " + n);
        System.out.println("Decryption (private) keys: " + d + ", " + n);
    }

    // Function to generate a valid public exponent e
    public static BigInteger generateE(BigInteger phi) {
        BigInteger e;
        Random rand = new Random();
        do {
            e = new BigInteger(phi.bitLength(), rand);
        } while (e.compareTo(BigInteger.TWO) < 0 || !phi.gcd(e).equals(BigInteger.ONE));
        return e;
    }
}

