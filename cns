package cns;

import java.io.*;
import java.util.*;

public class HillCipher {

    static float[][] a = new float[3][3];   // key matrix
    static float[][] b = new float[3][3];   // inverse matrix
    static float[][] mes = new float[3][1]; // message matrix
    static float[][] res = new float[3][1]; // encrypted
    static float[][] decrypt = new float[3][1]; // decrypted

    static BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
    static Scanner sc = new Scanner(System.in);

    public static void main(String[] args) throws IOException {

        getkeymes();

        // Encryption: res = a * mes
        for(int i=0;i<3;i++)
            for(int j=0;j<1;j++)
                for(int k=0;k<3;k++)
                    res[i][j] += a[i][k] * mes[k][j];

        System.out.print("\nEncrypted string is: ");
        for(int i=0;i<3;i++) {
            System.out.print((char)((int)(res[i][0] % 26) + 97));
        }

        inverse(); // find inverse matrix

        // Decryption: decrypt = b * res
        for(int i=0;i<3;i++)
            for(int j=0;j<1;j++)
                for(int k=0;k<3;k++)
                    decrypt[i][j] += b[i][k] * res[k][j];

        System.out.print("\nDecrypted string is: ");
        for(int i=0;i<3;i++) {
            System.out.print((char)((int)(decrypt[i][0] % 26) + 97));
        }

        System.out.println();
    }

    public static void getkeymes() throws IOException {

        System.out.println("Enter 3x3 key matrix:");
        for(int i=0;i<3;i++)
            for(int j=0;j<3;j++)
                a[i][j] = sc.nextFloat();

        System.out.print("Enter 3-letter string: ");
        String msg = br.readLine();

        for(int i=0;i<3;i++)
            mes[i][0] = msg.charAt(i) - 97; // convert to 0–25
    }

    public static void inverse() {

        float[][] c = new float[3][3];

        // Copy matrix a to c
        for(int i=0;i<3;i++)
            for(int j=0;j<3;j++)
                c[i][j] = a[i][j];

        // Identity matrix
        for(int i=0;i<3;i++)
            for(int j=0;j<3;j++)
                b[i][j] = (i==j) ? 1 : 0;

        // Gauss-Jordan method
        for(int k=0;k<3;k++) {
            for(int i=0;i<3;i++) {
                if(i != k) {
                    float factor = c[i][k] / c[k][k];
                    for(int j=0;j<3;j++) {
                        c[i][j] -= factor * c[k][j];
                        b[i][j] -= factor * b[k][j];
                    }
                }
            }
        }

        // Normalize
        for(int i=0;i<3;i++)
            for(int j=0;j<3;j++)
                b[i][j] = b[i][j] / c[i][i];

        System.out.println("\nInverse Matrix:");
        for(int i=0;i<3;i++) {
            for(int j=0;j<3;j++)
                System.out.print(b[i][j] + " ");
            System.out.println();
        }
    }
}

