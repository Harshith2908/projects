<!DOCTYPE html>
<html>
<head>
    <title>Diffie-Hellman Key Exchange</title>
</head>
<body>

<h2>Diffie-Hellman Key Exchange</h2>

<label>Enter Prime Number (p): </label>
<input type="number" id="p"><br><br>

<label>Enter Base (g): </label>
<input type="number" id="g"><br><br>

<label>Enter Alice Private Key (Xa): </label>
<input type="number" id="xa"><br><br>

<label>Enter Bob Private Key (Xb): </label>
<input type="number" id="xb"><br><br>

<button onclick="calculate()">Calculate</button>

<h3 id="output"></h3>

<script>
function powerMod(base, exp, mod) {
    let result = 1;
    for (let i = 0; i < exp; i++) {
        result = (result * base) % mod;
    }
    return result;
}

function calculate() {

    let p = parseInt(document.getElementById("p").value);
    let g = parseInt(document.getElementById("g").value);
    let xa = parseInt(document.getElementById("xa").value);
    let xb = parseInt(document.getElementById("xb").value);

    // Public keys
    let Ya = powerMod(g, xa, p);
    let Yb = powerMod(g, xb, p);

    // Shared keys
    let Ka = powerMod(Yb, xa, p);
    let Kb = powerMod(Ya, xb, p);

    document.getElementById("output").innerHTML =
        "Alice Public Key (Ya): " + Ya + "<br>" +
        "Bob Public Key (Yb): " + Yb + "<br>" +
        "Shared Key (Alice): " + Ka + "<br>" +
        "Shared Key (Bob): " + Kb;
}
</script>

