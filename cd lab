write recursive descent parser for the grammar.  
S->(L) S->a L->L, S L->S

#include<stdio.h>

int i = 0;
int error = 0;   // Error flag
char input[20];

// Function declarations
void S();
void L();
void Ldash();
void match(char c);

// Match function
void match(char c)
{
    if(input[i] == c)
        i++;
    else
    {
        printf("Error at position %d\n", i);
        error = 1;
    }
}

// S → (L) | a
void S()
{
    if(input[i] == '(')
    {
        match('(');
        L();
        match(')');
    }
    else if(input[i] == 'a')
    {
        match('a');
    }
    else
    {
        printf("Error in S at position %d\n", i);
        error = 1;
    }
}

// L → S L'
void L()
{
    S();
    Ldash();
}

// L' → , S L' | ε
void Ldash()
{
    if(input[i] == ',')
    {
        match(',');
        S();
        Ldash();
    }
}

// Main function
int main()
{
    printf("Enter the string: ");
    scanf("%s", input);

    S();

    if(error == 0 && input[i] == '\0')
        printf("Accepted\n");
    else
        printf("Rejected\n");

    return 0;
}


