Implementation of symbol table.

#include<stdio.h>
#include<stdlib.h>
#include<string.h>

struct table
{
    char var[10];
    int value;
};

struct table tbl[20];
int n = 0;

int search(char variable[])
{
    int i;
    for(i = 0; i < n; i++)
    {
        if(strcmp(tbl[i].var, variable) == 0)
            return i;
    }
    return -1;
}

void create()
{
    int i, j;
    printf("Enter number of entries: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        printf("Enter variable and value: ");
        scanf("%s %d", &tbl[i].var, &tbl[i].value);

        // Check starts with alphabet
        if(!(tbl[i].var[0] >= 'a' && tbl[i].var[0] <= 'z') &&
           !(tbl[i].var[0] >= 'A' && tbl[i].var[0] <= 'Z'))
        {
            printf("Variable must start with alphabet!\n");
            i--;
            continue;
        }

        // Check duplicate
        for(j = 0; j < i; j++)
        {
            if(strcmp(tbl[i].var, tbl[j].var) == 0)
            {
                printf("Duplicate variable! Enter again.\n");
                i--;
                break;
            }
        }
    }
}

void insert()
{
    if(n >= 20)
    {
        printf("Table full!\n");
        return;
    }

    printf("Enter variable and value: ");
    scanf("%s %d", tbl[n].var, &tbl[n].value);

    if(!(tbl[n].var[0] >= 'a' && tbl[n].var[0] <= 'z') &&
       !(tbl[n].var[0] >= 'A' && tbl[n].var[0] <= 'Z'))
    {
        printf("Invalid variable name!\n");
        return;
    }

    if(search(tbl[n].var) != -1)
    {
        printf("Variable already exists!\n");
        return;
    }

    n++;
}

void modify()
{
    char variable[10];
    int pos;

    printf("Enter variable to modify: ");
    scanf("%s", variable);

    pos = search(variable);

    if(pos == -1)
    {
        printf("Variable not found!\n");
        return;
    }

    printf("Enter new value: ");
    scanf("%d", &tbl[pos].value);
}

void display()
{
    int i;
    printf("\nVARIABLE\tVALUE\n");
    for(i = 0; i < n; i++)
    {
        printf("%s\t\t%d\n", tbl[i].var, tbl[i].value);
    }
}

int main()
{
    int ch;

    do
    {
        printf("\n1.Create\n2.Insert\n3.Modify\n4.Search\n5.Display\n6.Exit\n");
        printf("Enter choice: ");
        scanf("%d", &ch);

        switch(ch)
        {
            case 1: create(); break;
            case 2: insert(); break;
            case 3: modify(); break;
            case 4:
            {
                char v[10];
                printf("Enter variable: ");
                scanf("%s", v);

                int pos = search(v);
                if(pos == -1)
                    printf("Not found\n");
                else
                    printf("Found at position %d with value %d\n", pos, tbl[pos].value);
                break;
            }
            case 5: display(); break;
        }
    } while(ch != 6);

    return 0;
}


week-2
Develop a lexical analyzer to recognize a few patterns inc (ex. Identifiers, constants, comments, operators 
etc.) 

#include<stdio.h>
#include<ctype.h>
#include<string.h>

char keywords[][10] = {"int","float","if","else","while","return"};

int isKeyword(char *str)
{
    int i;
    for(i = 0; i < 6; i++)
    {
        if(strcmp(str, keywords[i]) == 0)
            return 1;
    }
    return 0;
}

int main()
{
    char c, buffer[50];
    int i = 0;

    printf("Enter program:\n");

    while((c = getchar()) != EOF)
    {
        // IDENTIFIER or KEYWORD
        if(isalpha(c))
        {
            i = 0;
            buffer[i++] = c;

            while(isalnum(c = getchar()) || c == '_')
                buffer[i++] = c;

            buffer[i] = '\0';

            if(isKeyword(buffer))
                printf("Keyword: %s\n", buffer);
            else
                printf("Identifier: %s\n", buffer);

            ungetc(c, stdin);
        }

        // NUMBER (CONSTANT)
        else if(isdigit(c))
        {
            int num = c - '0';
            while(isdigit(c = getchar()))
                num = num * 10 + (c - '0');

            printf("Constant: %d\n", num);
            ungetc(c, stdin);
        }

        // OPERATORS
        else if(c == '+' || c == '-' || c == '*' || c == '/' || c == '=')
        {
            printf("Operator: %c\n", c);
        }

        // COMMENTS
        else if(c == '/')
        {
            char next = getchar();

            // Single line comment
            if(next == '/')
            {
                printf("Single-line Comment\n");
                while((c = getchar()) != '\n');
            }
            // Multi-line comment
            else if(next == '*')
            {
                printf("Multi-line Comment\n");
                while(1)
                {
                    if((c = getchar()) == '*' && getchar() == '/')
                        break;
                }
            }
            else
            {
                printf("Operator: /\n");
                ungetc(next, stdin);
            }
        }

        // SPECIAL SYMBOLS
        else if(c == '(' || c == ')' || c == '{' || c == '}' || c == ';')
        {
            printf("Special Symbol: %c\n", c);
        }
    }

    return 0;
}



