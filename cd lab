mplement any one storage allocation strategies (heap, stack, static) 

#include <stdio.h>
#include <stdlib.h>

#define size 5

struct stack
{
    int s[size];
    int top;
} st;

// Check stack full
int stfull()
{
    if(st.top >= size - 1)
        return 1;
    else
        return 0;
}

// Push operation
void push(int item)
{
    st.top++;
    st.s[st.top] = item;
}

// Check stack empty
int stempty()
{
    if(st.top == -1)
        return 1;
    else
        return 0;
}

// Pop operation
int pop()
{
    int item;
    item = st.s[st.top];
    st.top--;
    return item;
}

// Display stack
void display()
{
    int i;
    if(stempty())
        printf("\nStack is Empty!");
    else
    {
        printf("\nStack elements are:\n");
        for(i = st.top; i >= 0; i--)
            printf("%d\n", st.s[i]);
    }
}

// Main function
int main()
{
    int item, choice;
    char ans;

    st.top = -1;

    printf("\n\tImplementation Of Stack");

    do
    {
        printf("\n\nMain Menu");
        printf("\n1.Push \n2.Pop \n3.Display \n4.Exit");
        printf("\nEnter Your Choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                printf("\nEnter the item to be pushed: ");
                scanf("%d", &item);
                if(stfull())
                    printf("\nStack is Full!");
                else
                    push(item);
                break;

            case 2:
                if(stempty())
                    printf("\nStack Underflow!");
                else
                {
                    item = pop();
                    printf("\nPopped element is %d", item);
                }
                break;

            case 3:
                display();
                break;

            case 4:
                exit(0);
        }

        printf("\nDo you want to continue? (y/n): ");
        scanf(" %c", &ans);

    } while(ans == 'y' || ans == 'Y');

    return 0;
}

