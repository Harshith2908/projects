// 3.Write a C program to calculate the first function for the grammar.
//  E->E+T E->T T->T*F T->FF->(E)/id
#include <stdio.h>
#include <ctype.h>

char prod[6][10] = {
    "E=E+T",
    "E=T",
    "T=T*F",
    "T=F",
    "F=(E)",
    "F=id"};

char res[10];
int n = 0;
void first(char c)
{
    int i=0;
    for(i=0;i<6;i++)
    {
        if(prod[i][0]==c)
        {
            if(prod[i][2]==c)
                continue;
            if(!isupper(prod[i][2]))
            {
                res[n++]=prod[i][2];
            }
            else{
                first(prod[i][2]);
            }
        }
    }
}
void main()
{
    printf("Enter the Non-Terminal:");
    char c;
    scanf("%c",&c);
    n=0;
    int i;
    first(c);
    printf("FIRST(%c) : { ",c);
    for(i=0;i<n;i++)
    {
        printf("'%c',",res[i]);
    }
    printf("}");
}

