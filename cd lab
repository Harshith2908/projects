8. Write a lex program to count the number of words and number of lines in each file or program. 
                                                                      counter.l
%{
#include <stdio.h>

int word_count = 0;
int line_count = 0;
%}

%option noyywrap

%%

\n              { line_count++; }          /* Count lines */

[a-zA-Z0-9_]+  { word_count++; }          /* Count words */
         /* Count last line if no newline */

.               ;                         /* Ignore other characters */

%%

int main(int argc, char *argv[])
{
    if (argc < 2)
    {
        printf("Usage: %s <filename>\n", argv[0]);
        return 1;
    }

    FILE *file = fopen(argv[1], "r");
    if (!file)
    {
        printf("Cannot open file\n");
        return 1;
    }

    yyin = file;     /* Set input file */
    yylex();         /* Start scanning */

    printf("Number of lines: %d\n", line_count);
    printf("Number of words: %d\n", word_count);

    fclose(file);
    return 0;
}

week-10
 write recursive descent parser for the grammar.  
E->E+T E->T T->T*F T->F F->(E)/id.

#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>

char input[100];
int i = 0;

void E(), Edash(), T(), Tdash(), F();

void match(char c)
{
    if (input[i] == c)
        i++;
    else
    {
        printf("Error at position %d\n", i);
        exit(0);
    }
}

// E → T E'
void E()
{
    T();
    Edash();
}

// E' → + T E' | ε
void Edash()
{
    if (input[i] == '+')
    {
        match('+');
        T();
        Edash();
    }
}

// T → F T'
void T()
{
    F();
    Tdash();
}

// T' → * F T' | ε
void Tdash()
{
    if (input[i] == '*')
    {
        match('*');
        F();
        Tdash();
    }
}

// F → (E) | id
void F()
{
    if (input[i] == '(')
    {
        match('(');
        E();
        match(')');
    }
    else if (isalnum(input[i])) // id
    {
        i++; // consume identifier
    }
    else
    {
        printf("Error in F at position %d\n", i);
        exit(0);
    }
}

int main()
{
    printf("Enter expression: ");
    scanf("%s", input);

    E();

    if (input[i] == '\0')
        printf("Accepted\n");
    else
        printf("Rejected\n");

    return 0;
}

