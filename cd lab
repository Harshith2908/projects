    char variables[10], types[10], expression[50];

    printf("Enter number of variables: ");
    scanf("%d", &n);

    // Read variable names and types
    for(i = 0; i < n; i++)
    {
        printf("Enter variable name and type (e.g., x f): ");
        scanf(" %c %c", &variables[i], &types[i]);

        if(types[i] == 'f')
            needFloat = 1;   // float exists
    }

    printf("Enter expression: ");
    scanf("%s", &expression);

    // Check if division exists
    for(i = 0; expression[i]; i++)
    {
        if(expression[i] == '/')
            needFloat = 1;
    }

    // Check first variable type
    for(i = 0; i < n; i++)
    {
        if(expression[0] == variables[i])
        {
            if(needFloat && types[i] != 'f')
                printf("Error: must be float\n");
            else
                printf("Correct\n");
        }
    }

    return 0;
