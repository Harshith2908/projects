Develop a lexical analyzer to recognize a few patterns inc (ex. Identifiers, constants, comments, operators etc.)

#include <stdio.h>
#include <string.h>
#include <ctype.h>

int isKeyword(char str[])
{
    char keywords[][10] =
    {
        "for","while","do","int","float","char",
        "double","static","switch","case","if","else","break"
    };

    int i;
    for(i = 0; i < 13; i++)
    {
        if(strcmp(str, keywords[i]) == 0)
            return 1;
    }
    return 0;
}

int main()
{
    FILE *fp;
    char ch, buffer[50];
    int i = 0;

    fp = fopen("input.c", "r");
    if(fp == NULL)
    {
        printf("Error opening file\n");
        return 1;
    }

    printf("\n--- LEXICAL ANALYSIS OUTPUT ---\n");

    while((ch = fgetc(fp)) != EOF)
    {
        // IDENTIFIERS / KEYWORDS
        if(isalpha(ch) || ch == '_')
        {
            buffer[i++] = ch;
            while(isalnum(ch = fgetc(fp)) || ch == '_')
            {
                buffer[i++] = ch;
            }
            buffer[i] = '\0';
            i = 0;

            if(isKeyword(buffer))
                printf("%s : Keyword\n", buffer);
            else
                printf("%s : Identifier\n", buffer);

            fseek(fp, -1, SEEK_CUR);
        }

        // NUMBERS (CONSTANTS)
        else if(isdigit(ch))
        {
            int num = ch - '0';
            while(isdigit(ch = fgetc(fp)))
            {
                num = num * 10 + (ch - '0');
            }
            printf("%d : Constant\n", num);
            fseek(fp, -1, SEEK_CUR);
        }

        // COMMENTS
        else if(ch == '/')
        {
            char next = fgetc(fp);

            // Single-line comment
            if(next == '/')
            {
                while((ch = fgetc(fp)) != '\n' && ch != EOF);
                printf("// comment detected\n");
            }
            // Multi-line comment
            else if(next == '*')
            {
                char prev;
                while((ch = fgetc(fp)) != EOF)
                {
                    if(prev == '*' && ch == '/')
                        break;
                    prev = ch;
                }
                printf("/* comment detected */\n");
            }
            else
            {
                printf("/ : Operator\n");
                fseek(fp, -1, SEEK_CUR);
            }
        }

        // OPERATORS
        else if(ch == '+' || ch == '-' || ch == '*' || ch == '=' || ch == '%')
        {
            printf("%c : Operator\n", ch);
        }

        // SPECIAL SYMBOLS
        else if(ch == ';' || ch == ',' || ch == '(' || ch == ')' || ch == '{' || ch == '}')
        {
            printf("%c : Special Symbol\n", ch);
        }
    }

    fclose(fp);
    return 0;
}


